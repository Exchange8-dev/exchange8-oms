    "/v1/admin/algo-orders": {
      "post": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`POST /v1/admin/algo-orders` - the durable algo parents (RFW page data;\nRLS-scoped read of `oms.algo_order` with explicit `env_id`). Gate: the\n`algos` read scope.",
        "operationId": "admin_algo_orders",
        "responses": {
          "200": {
            "description": "Algo orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlgoOrderRow"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": []
      }
    },
    "/v1/admin/algo-orders/{id}/pause": {
      "post": {
        "tags": [
          "exchange8-admin"
        ],
        "summary": "`POST /v1/admin/algo-orders/{id}/pause` - pause the running parent\n(`running → paused`; the durable binding + transition event + audit).",
