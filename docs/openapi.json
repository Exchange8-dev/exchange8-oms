  "components": {
    "schemas": {
      "AdminRfwPage": {
        "description": "The RFW page-definition document (transparent renderer-contract JSON)."
      },
      "AlgoOrderRow": {
        "type": "object",
        "description": "One durable algo parent row (the `algos` page table data).",
        "required": [
          "id",
          "parent_order_id",
          "algo_type",
          "state"
        ],
        "properties": {
          "algo_type": {
            "type": "string",
            "description": "Algo type (the CHECK vocabulary)."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Row id."
          },
          "parent_order_id": {
            "type": "integer",
            "format": "int64",
            "description": "Parent order id."
          },
          "slice_size": {
            "type": [
              "string",
              "null"
            ],
            "description": "Slice size (raw qty text)."
          },
          "state": {
            "type": "string",
            "description": "Durable lifecycle state (the CHECK vocabulary)."
          }
        }
      },
      "AlgoStateAck": {
        "type": "object",
        "description": "Algo pause/resume ack.",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The algo order id."
          },
          "state": {
            "type": "string",
            "description": "The new algo state."
          }
        }
      },
      "AttributeUpserted": {
        "type": "object",
        "description": "An attribute upsert result.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `upserted`."
          }
        }
      },
      "ConditionalRow": {
        "type": "object",
        "description": "One held conditional row (the `conditionals` page table data).",
        "required": [
          "order_id",
          "instrument_id",
          "trigger_ref",
